# ---- How screenshots are identified ---------------------------------------------
# MAGPIE_ANALYZER: auto (default) | claude | local | hybrid | ocr
#   claude - Claude with web search: most accurate
#   local  - your on-prem LLM only (nothing leaves your network except metadata lookups)
#   hybrid - local first, Claude only when the local model is under MAGPIE_ESCALATE_BELOW confidence
#   ocr    - no LLM: OCR + rules; rough, flags everything for review
#   auto   - hybrid if both are configured, else whichever one is, else ocr
# Recommended: hybrid. Your local model handles the easy screenshots for ~free; only the ones it is
# unsure about (confidence < MAGPIE_ESCALATE_BELOW) go to Claude. If the local server is down,
# Magpie uses Claude and retries the local server after 5 minutes.
MAGPIE_ANALYZER=hybrid
MAGPIE_ESCALATE_BELOW=70

# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# On-prem LLM: any OpenAI-compatible server. Examples:
#   Ollama     http://localhost:11434/v1   (docker compose: http://ollama:11434/v1)
#   vLLM       http://gpu-box:8000/v1
#   LM Studio  http://localhost:1234/v1
LOCAL_LLM_URL=http://ollama:11434/v1
# A vision model reads the screenshot itself: qwen3-vl:8b (default), qwen3-vl:30b, Gemma 4, qwen2.5vl:7b... (docs/MODELS.md)
LOCAL_LLM_MODEL=qwen3-vl:8b
# NVIDIA NIM instead (see docs/MODELS.md → NVIDIA NIM):
#   hosted (build.nvidia.com, free for development):  LOCAL_LLM_URL=https://integrate.api.nvidia.com/v1
#                                                      NVIDIA_API_KEY=nvapi-...   LOCAL_LLM_MODEL=meta/llama-3.2-90b-vision-instruct
#   self-hosted container (docker compose --profile nim): LOCAL_LLM_URL=http://nim:8000/v1   NGC_API_KEY=...
# LOCAL_LLM_PROVIDER=auto          # auto | openai | nim (auto detects NVIDIA's API URL and nvapi- keys)
# Text-only models (llama3.1, qwen2.5, mistral...) work too: set this to false and they get the OCR text.
# LOCAL_LLM_VISION=true
# LOCAL_LLM_API_KEY=
# LOCAL_LLM_TIMEOUT=300

# Running cost of the local inference box, for the usage report (USD/hour; e.g. 350 W at $0.20/kWh = 0.07)
# MAGPIE_LOCAL_COST_PER_HOUR=0

# ---- Cost controls, any provider (see docs/COSTS.md) ------------------------------
# Stop calling paid providers once this month's measured spend reaches this (USD, 0 = no limit)
# MAGPIE_MONTHLY_BUDGET_USD=0
# Cap on each reply, in tokens (0 = provider default)
# MAGPIE_MAX_OUTPUT_TOKENS=0
# Screenshots are scaled down to this longest edge before being sent to any model
# MAGPIE_MAX_IMAGE_EDGE=2000

# ---- Claude options ---------------------------------------------------------------
# New screenshots go through the Message Batches API: 50% cheaper, results usually within an hour
# (max 24 h). Re-analyses and corrections always run immediately.
MAGPIE_CLAUDE_BATCH=true
# MAGPIE_BATCH_POLL_SECONDS=60
# How hard Claude thinks: low | medium | high | xhigh | max
MAGPIE_EFFORT=medium
# Max tokens Claude reads from each fetched web page (0 = no cap)
MAGPIE_FETCH_MAX_TOKENS=8000
# Price overrides, USD per million tokens: {"model-id": [input, output]}
# MAGPIE_PRICING=

# OCR pre-pass: rapidocr (default, bundled, CPU) | tesseract (Hebrew, Arabic, Cyrillic...) | off
# MAGPIE_OCR=rapidocr
# MAGPIE_OCR_LANGS=eng+heb        # tesseract only

# Metadata lookups (TMDB, GitHub, Open Library, recipe pages). Set to off for air-gapped installs.
# MAGPIE_ENRICH=on

# Optional: Claude model override (default: claude-opus-5)
# MAGPIE_MODEL=claude-opus-5

# Optional enrichers. Without them Magpie still works, relying on Claude's web search.
# TMDB (posters, overview, genres, cast, IMDb id): https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# OMDb (IMDb rating, Rotten Tomatoes, Metacritic): https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=
# GitHub token raises the API rate limit from 60 to 5000 requests/hour
GITHUB_TOKEN=

# Plugins: add saved films / TV shows to your download manager (can also be set in the app: Settings -> Radarr / Sonarr)
# RADARR_URL=http://radarr:7878
# RADARR_API_KEY=
# SONARR_URL=http://sonarr:8989
# SONARR_API_KEY=

# Install plugins from a git repository or a .py file (Settings -> Plugins). Off by default: a plugin runs code on this
# server, so only turn it on if you will install plugins you trust. Needs a restart; not changeable from the app.
# MAGPIE_ALLOW_PLUGIN_INSTALL=true

# Where the database and uploaded screenshots are stored (default: ./data)
# MAGPIE_DATA_DIR=./data

# Recommended when the server is reachable beyond localhost (phone, LAN, Tailscale, internet).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MAGPIE_API_TOKEN=

# Optional: region for "where to watch" streaming info (default US)
# MAGPIE_REGION=US
# Language for movie/TV titles and descriptions fetched from TMDB (en, he, ar, es, fr, de, it, pt, nl, pl, ru, tr, ja, ko, zh)
# MAGPIE_LANGUAGE=en
